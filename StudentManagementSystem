	private Student[] addStudent(Student[] record)
	{
		Scanner keyboard = new Scanner(System.in);

		System.out.println("Adding a new student:");

		System.out.println("Enter new student name: ");
		String name = keyboard.nextLine();

		System.out.println("Enter student ID: ");
		int id = keyboard.nextInt();
		keyboard.nextLine();

		Student newStudent = new Student(id, name);

		System.out.println("How many subjects does this student have? ");
		int numSubjects = keyboard.nextInt();
		keyboard.nextLine();

		for(int i = 0; i < numSubjects;i++)
		{
			System.out.println("Enter the name of subject #" + (i + 1) + ": ");
			String subjectName = keyboard.nextLine();

			System.out.println("Enter the grade of subject #" + (i + 1) + ": ");
			int grade = keyboard.nextInt();
			keyboard.nextLine();

			newStudent.addSubject(new Subject(subjectName, grade));
		}

		Student[] newRecord = new Student[record.length + 1];

		for (int i = 0; i < record.length; i++)
			newRecord[i] = record[i];
		
		newRecord[record.length] = newStudent;

		System.out.println("The new student has been added!");

		return newRecord;
	}

	private Student[] removeStudent(Student[] record)
	{
		Scanner keyboard = new Scanner(System.in);
	
		System.out.println("Which student would you like to remove?");

		for (int i = 0; i < record.length; i++)
		{
			System.out.println((i + 1) + ". " + record[i].getName());
		}

		System.out.println("Selection: ");
		int selection = keyboard.nextInt();
		keyboard.nextLine();

		if (selection < 1 || selection > record.length)
		{
			System.out.println("Invalid selection. No student removed.");
			return record;
		}
	
		Student[] newRecord = new Student[record.length - 1];

		int index = 0;
		for (int i = 0; i < record.length; i++)
		{
			if(i != selection - 1)
			{
				newRecord[index] = record[i];
				index++;
			}
		}
		
		System.out.println("The student has been removed!");

		return newRecord;
	}

